{
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_path=api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__vercel_path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 2 * * *"
    }
  ]
}